# OpenRouter is the sole model provider, test and production alike (conception §3.2).
# Only MODEL_ID changes between environments — never a second provider, never a router alias.

# Test (free tier, verify tool-calling support against fiches de test before relying on it):
MODEL_ID=google/gemma-4-31b-it:free

# Production (pinned, never a floating tag — conception §13.1):
# MODEL_ID=anthropic/claude-sonnet-5

OPENROUTER_API_KEY=

# SQLite database paths (mounted as Docker volumes — conception §12, §13.3)
REFERENCE_DB_PATH=data/reference/reference.db
MISSION_DB_PATH=data/mission/mission.db
