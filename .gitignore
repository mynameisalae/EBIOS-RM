__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/

# Runtime databases (mounted as Docker volumes, never committed)
data/reference/*.db
data/mission/*.db
!data/reference/.gitkeep
!data/mission/.gitkeep

# Secrets
.env
*.env.local

# Internal working documents — kept locally, not published.
# The conception is the project's private design reference; HANDOFF.md is passed
# between working sessions by hand.
docs/conception/
docs/HANDOFF.md

# Licensed referential text — never redistributed (conception §12.2).
# ISO 27001 Annex A is copyrighted (AFNOR licence, internal use only), so its
# control text stays local. The manifest is kept: it declares the framework
# without reproducing any licensed content. Freely reusable referentials
# (ANSSI, NIST, RGPD) are committed normally.
src/ebios_rm/plugins/frameworks/iso27001/controls.json

# Generated reports (contain client data)
*.docx
!docs/**/*.docx

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
